<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- Recorded patient location summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnGetLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REFRESH RECORDED LOCATIONS"
            android:backgroundTint="#00897B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvLatitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS Records: 0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvLongitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Selected record: None"
            android:textSize="14sp"
            android:textColor="#555555" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Recorded patient locations only"
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="#CC0000" />

        <Button
            android:id="@+id/btnLocateMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OPEN SELECTED RECORDED PLACE"
            android:backgroundTint="#E0E0E0"
            android:textColor="#AAAAAA"
            android:layout_marginTop="8dp"
            android:enabled="false" />

    </LinearLayout>

    <!-- Map fills the rest of the screen -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E8EEF0" />

    <!-- Loading / No-data overlay -->
    <ProgressBar
        android:id="@+id/mapLoadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvMapStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:gravity="center"
        android:textColor="#888888"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
