<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RuralHealthSync" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/health_green</item>
        <item name="colorPrimaryVariant">@color/health_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/medical_blue</item>
        <item name="colorSecondaryVariant">@color/medical_blue_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/health_green_dark</item>
        <item name="android:windowBackground">@color/surface_background</item>
    </style>

    <style name="Theme.RuralHealthSync.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/health_green</item>
        <item name="colorPrimaryVariant">@color/health_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/medical_blue</item>
        <item name="colorSecondaryVariant">@color/medical_blue_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/health_green_dark</item>
        <item name="android:windowBackground">@color/surface_background</item>
    </style>

    <style name="CircleShapeAppearanceOverlay" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Card style with subtle elevation and ripple -->
    <style name="HealthCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Primary button style -->
    <style name="HealthButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/health_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="Theme.RuralHealthSync.Material3" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/health_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/health_green_surface</item>
        <item name="colorOnPrimaryContainer">@color/health_green_dark</item>
        <item name="colorSecondary">@color/medical_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/medical_blue_surface</item>
        <item name="colorOnSecondaryContainer">@color/medical_blue_dark</item>
        <item name="android:statusBarColor">@color/health_green_dark</item>
    </style>
</resources>
